# ==========================================
# Supabase Configuration (PostgreSQL + Auth + Realtime)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ==========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ==========================================
# Cloudinary Configuration (Image Uploads)
# Get these from: Cloudinary Console
# ==========================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
 
# ==========================================
# Resend Email API Configuration (Real OTP Delivery)
# Get this from: https://resend.com/api-keys
# ==========================================
VITE_RESEND_API_KEY=re_your_resend_api_key_here
